#!/bin/sh
# Prints the editor state of the Neovim working on this directory (current
# file, cursor, selection) for coding agents. Prints nothing when there is none.
#   agent-editor-context json   UserPromptSubmit hook output (Claude Code, Codex)
#   agent-editor-context text   plain text (opencode, pi, scripts)
# Neovim writes the state (lua/config/editor_context.lua); this only reads it.
exec nvim --clean -l "$(dirname "$0")/agent-editor-context.lua" "${1:-text}" </dev/null 2>/dev/null
